# ==============================================================================
# Nexus Environment Configuration Example
# Copy this file to .env for local development. NEVER commit real secrets to Git.
# ==============================================================================

# Core Runtime
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# PostgreSQL (Authoritative Durable Storage)
# Local docker-compose default: postgresql://nexus_dev:nexus_dev_password@localhost:5432/nexus_dev
DATABASE_URL=postgresql://nexus_dev:nexus_dev_password@localhost:5432/nexus_dev
DATABASE_MAX_CONNECTIONS=10

# Redis (Queues, Background Jobs & Ephemeral Caching)
# Local docker-compose default: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Discord Application Credentials (from Discord Developer Portal)
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=placeholder_discord_client_secret_do_not_commit
DISCORD_BOT_TOKEN=placeholder_discord_bot_token_do_not_commit
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Web & Session Security
# Generate using `openssl rand -hex 32`
SESSION_SECRET=dev_session_secret_change_me_to_random_64_characters_min
CSRF_SECRET=dev_csrf_secret_change_me_to_random_64_characters_min

# Object Storage (S3-compatible, private by default)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexus-assets-dev
S3_ACCESS_KEY=nexus_dev_key
S3_SECRET_KEY=nexus_dev_secret
