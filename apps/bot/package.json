    "@nexus/database": "workspace:*",
    "@nexus/discord-adapter": "workspace:*",
    "@nexus/domain": "workspace:*",
    "@nexus/observability": "workspace:*",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
